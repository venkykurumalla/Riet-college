  "title": "Advanced Calculation Techniques",
  "tagline": "Year 4 — Algebraic identities, base-and-deviation, vedic-style methods and percentage fractions for fast exact arithmetic",
  "estimatedMinutes": 55,
  "difficulty": "Advanced",
  "introduction": {
    "overview": "Fast exact arithmetic comes from a small toolkit: squaring numbers near a base, multiplying by 11, 25, 99 or 101, using (a + b)(a − b) = a² − b², and converting percentages to fractions. Each technique turns a long multiplication into two or three short steps. The tools are valid for every input; the skill is spotting when one applies.",
    "placementRelevance": "Calculation time decides how many questions you attempt; these techniques save 15–30 seconds on each arithmetic-heavy question.",
    "realWorldContext": "Mental arithmetic for bills, discounts and estimates uses the same shortcuts."
  },
  "learningObjectives": [
    "Square numbers near 50 and 100 quickly",
    "Multiply by 5, 9, 11, 25, 99 and 101",
    "Use a² − b² and (a ± b)² for products",
    "Use percentage–fraction equivalents",
    "Verify with digit sums (casting out nines)"
  ],
  "prerequisiteKnowledge": {
    "requiredTopics": [
      "Number System",
      "Simplification",
      "Percentages"
    ],
    "quickRefresher": "(a + b)² = a² + 2ab + b²; (a − b)² = a² − 2ab + b²; (a + b)(a − b) = a² − b²."
  },
  "conceptExplanation": {
    "coreDefinitions": [
      "Base: a convenient round number near the numbers being multiplied.",
      "Deviation: the difference between a number and the base.",
      "Percentage–fraction equivalent: 12.5% = 1/8, 16.67% = 1/6 and so on.",
      "Digit sum: the repeated sum of digits, used to check products.",
      "Complement: what a number lacks to reach a base."
    ],
    "theoreticalIntuition": "Almost every awkward product is a nearby easy product plus a small correction.",
    "visualOrMentalModel": "Look for a base (10, 50, 100) or an identity. Compute the easy product, then add or subtract the correction."
  },
  "importantRulesAndFormulas": [
    {
      "title": "Square near 50",
      "formula": "(50 + d)² = 2500 + 100d + d²",
      "description": "Numbers near 50.",
      "whenToUse": "Squares.",
      "simpleExample": "53² = 2500 + 300 + 9 = 2,809"
    },
    {
      "title": "Difference of squares",
      "formula": "ab = ((a + b)/2)² − ((a − b)/2)²",
      "description": "Close numbers.",
      "whenToUse": "Products.",
      "simpleExample": "47 × 53 = 50² − 3² = 2,491"
    },
    {
      "title": "Multiply by 25",
      "formula": "n × 25 = n × 100 ÷ 4",
      "description": "Any n.",
      "whenToUse": "Quick.",
      "simpleExample": "84 × 25 = 8,400 ÷ 4 = 2,100"
    },
    {
      "title": "Multiply by 99",
      "formula": "n × 100 − n",
      "description": "Any n.",
      "whenToUse": "Quick.",
      "simpleExample": "37 × 99 = 3,700 − 37 = 3,663"
    },
    {
      "title": "Casting out nines",
      "formula": "Digit sums multiply",
      "description": "Check.",
      "whenToUse": "Verification.",
      "simpleExample": "47 × 53 ≡ 2 × 8 = 16 ≡ 7"
    }
  ],
  "detailedExplanation": {
    "mainNarrative": [
      "To find 53², write 50 + 3: 2,500 + 2 × 50 × 3 + 9 = 2,809. For 47 × 53 use the same centre 50: 50² − 3² = 2,491.",
      "For 37 × 99, write 3,700 − 37 = 3,663. For 84 × 25, divide 8,400 by 4 to get 2,100.",
      "To multiply by 11, add adjacent digits: 346 × 11 = 3 | 3+4 | 4+6 | 6 = 3,806.",
      "Percentage equivalents turn percentages into division: 12.5% of 640 = 640 ÷ 8 = 80; 16⅔% of 540 = 540 ÷ 6 = 90.",
      "To check 47 × 53 = 2,491, digit sums: 47 → 11 → 2; 53 → 8; 2 × 8 = 16 → 7; 2,491 → 16 → 7 ✓."
    ],
    "deepDiveAspects": [
      {
        "title": "Deviation method for 96 × 97",
        "content": "Base 100: deviations −4 and −3. Cross-subtract 96 − 3 = 93 (or 97 − 4), then multiply deviations 12: 9,312."
      },
      {
        "title": "Why casting out nines works",
        "content": "A number leaves the same remainder mod 9 as its digit sum; products preserve remainders."
      }
    ]
  },
