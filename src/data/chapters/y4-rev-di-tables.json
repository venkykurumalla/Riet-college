        {
          "stepNumber": 2,
          "title": "Decrease",
          "explanation": "25 ÷ 125 = 20%."
        }
      ],
      "finalAnswer": "25% up, 20% down",
      "whyItWorks": "The bases differ.",
      "commonTrap": "Saying 25% both ways.",
      "difficulty": "Foundation"
    },
    {
      "id": "ex-y4-rev-di-tables-2",
      "title": "Weighted average",
      "question": "Marks 60 for 30 students and 40 for 20 students. Average?",
      "givenInfo": [
        "60, 30",
        "40, 20"
      ],
      "conceptOrFormula": "Total ÷ total.",
      "steps": [
        {
          "stepNumber": 1,
          "title": "Totals",
          "explanation": "1,800 + 800 = 2,600."
        },
        {
          "stepNumber": 2,
          "title": "Average",
          "explanation": "2,600 ÷ 50 = 52."
        }
      ],
      "finalAnswer": "52",
      "whyItWorks": "Not 50.",
      "commonTrap": "Taking the simple mean.",
      "difficulty": "Intermediate"
    },
    {
      "id": "ex-y4-rev-di-tables-3",
      "title": "Points vs percent",
      "question": "A share rises from 30% to 35%. Percentage points and percent change?",
      "givenInfo": [
        "30%, 35%"
      ],
      "conceptOrFormula": "Two measures.",
