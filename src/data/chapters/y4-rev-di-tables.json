          "stepNumber": 1,
          "title": "Points",
          "explanation": "35 − 30 = 5."
        },
        {
          "stepNumber": 2,
          "title": "Percent",
          "explanation": "5 ÷ 30 = 16.7%."
        }
      ],
      "finalAnswer": "5 points; 16.7%",
      "whyItWorks": "Different measures.",
      "commonTrap": "Mixing them.",
      "difficulty": "Placement-Style"
