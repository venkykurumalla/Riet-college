  "difficulty": "Advanced",
  "introduction": {
    "overview": "Data interpretation uses a small set of calculations again and again: percentage change, share of total, ratio, average, weighted average, CAGR, and the rule that a percentage must use the right base. This table pairs each calculation with its formula and the typical trap, and then gives an approach for each chart type: write the numbers, add derived columns, and use approximation when options are well separated.",
    "placementRelevance": "A quick DI sheet saves time because you stop deriving the same formula in each set.",
    "realWorldContext": "Business reporting uses the same small set of calculations."
  },
  "learningObjectives": [
    "Recall the core DI formulas",
    "State the typical trap for each",
    "Choose an approach for each chart type",
    "Decide when to approximate",
    "Check bases and units"
  ],
  "prerequisiteKnowledge": {
    "requiredTopics": [
      "All earlier DI chapters"
    ],
    "quickRefresher": "Percent change = change ÷ old. Share = part ÷ whole. Weighted average = total ÷ total weight."
  },
  "conceptExplanation": {
    "coreDefinitions": [
      "Base: the quantity a percentage refers to.",
      "Weighted average: total ÷ total weight.",
      "CAGR: constant yearly growth rate.",
      "Percentage point: difference between two percentages.",
      "Derived column: a column you compute."
    ],
    "theoreticalIntuition": "Most DI is the same eight calculations in different clothing.",
    "visualOrMentalModel": "Write the numbers, name the calculation, check the base."
  },
  "importantRulesAndFormulas": [
    {
      "title": "Percent change",
      "formula": "(new − old) ÷ old",
      "description": "Growth.",
      "whenToUse": "Base is old.",
      "simpleExample": "100 → 125 is 25%"
    },
    {
      "title": "Share",
      "formula": "Part ÷ total",
      "description": "Pie.",
      "whenToUse": "Base is total.",
      "simpleExample": "30 of 120"
    },
    {
      "title": "Ratio",
      "formula": "Simplify by HCF",
      "description": "Comparison.",
      "whenToUse": "Order matters.",
      "simpleExample": "30 : 20"
    },
    {
      "title": "Average",
      "formula": "Total ÷ count",
      "description": "Mean.",
      "whenToUse": "Count terms.",
      "simpleExample": "(10 + 20 + 30)/3"
    },
    {
      "title": "Weighted average",
      "formula": "Σ(value × weight) ÷ Σ weight",
      "description": "Mixed groups.",
      "whenToUse": "Not simple mean.",
      "simpleExample": "60 and 40"
    },
    {
      "title": "CAGR",
      "formula": "(end/start)^(1/n) − 1",
      "description": "Growth over n years.",
      "whenToUse": "Not total ÷ n.",
      "simpleExample": "1.331^(1/3)"
    },
    {
      "title": "Percentage points",
      "formula": "Difference of two percentages",
      "description": "Share changes.",
      "whenToUse": "Not percent change.",
      "simpleExample": "30% → 35%"
    },
    {
      "title": "Approximation",
      "formula": "Round to two figures",
      "description": "Wide options.",
      "whenToUse": "Check spacing.",
      "simpleExample": "4,180 → 4,200"
    }
  ],
  "detailedExplanation": {
    "mainNarrative": [
      "Percent change from 100 to 125 is 25 ÷ 100 = 25%; the reverse change from 125 to 100 is 25 ÷ 125 = 20%.",
      "A share rising from 30% to 35% is 5 percentage points, or about 16.7% in percentage terms.",
      "A weighted average of marks 60 (30 students) and 40 (20 students) is (1,800 + 800) ÷ 50 = 52, not 50.",
      "CAGR from 1,000 to 1,331 in 3 years is 10%: 1.331^(1/3) = 1.1.",
      "For each chart type: write the numbers in a table, add derived columns, answer from the table."
    ],
    "deepDiveAspects": [
      {
        "title": "Pie charts",
        "content": "Shares must sum to 100%; angles are share × 3.6°."
      },
      {
        "title": "Line charts",
        "content": "Read the slope: steeper means faster change."
      }
    ]
  },
