    "requiredTopics": [
      "Speed Mathematics Shortcuts"
    ],
    "quickRefresher": "Rounding and adjusting: 398 + 247 = 400 + 247 − 2."
  },
  "conceptExplanation": {
    "coreDefinitions": [
      "Left-to-right: starting with the largest place value.",
      "Complement: the amount to reach a round number.",
      "Round-and-adjust: use a round number then correct.",
      "Splitting: a × (b + c) = ab + ac.",
      "Doubling-halving: a × b = 2a × b/2."
    ],
    "theoreticalIntuition": "The mind keeps small numbers easily; give it small numbers.",
    "visualOrMentalModel": "Round to a friendly number, compute, correct; split big products into tens and units."
  },
