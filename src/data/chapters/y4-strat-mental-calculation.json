  "detailedExplanation": {
    "mainNarrative": [
      "398 + 247: add 400 + 247 = 647 and take away 2: 645.",
      "1,000 − 647: complements digit by digit (9, 9, 10): 353.",
      "23 × 17: 23 × 10 = 230 and 23 × 7 = 161; total 391.",
      "35 × 14: double 35 and halve 14 to get 70 × 7 = 490.",
      "347 + 285: 300 + 200 = 500; 40 + 80 = 120; 7 + 5 = 12; 500 + 120 + 12 = 632."
    ],
