    "coreDefinitions": [
      "Formula: a rule expressing a relation.",
      "Check: a small example that confirms the formula.",
      "Retrieval practice: recalling instead of rereading.",
      "Similar formulas: ones that are easy to confuse.",
      "Unit: what the answer measures."
    ],
    "theoreticalIntuition": "A formula is a compressed story; the check restores the story.",
    "visualOrMentalModel": "Cover the formula, recall it, then uncover and compare."
