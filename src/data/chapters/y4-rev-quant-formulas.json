  "importantRulesAndFormulas": [
    {
      "title": "Percent change",
      "formula": "(new − old) ÷ old × 100",
      "description": "Growth.",
      "whenToUse": "Percentages.",
      "simpleExample": "80 → 100 is 25%"
    },
    {
      "title": "Profit %",
      "formula": "(SP − CP) ÷ CP × 100",
      "description": "Profit.",
      "whenToUse": "Base is cost.",
      "simpleExample": "120 on 100 is 20%"
    },
    {
      "title": "Simple interest",
      "formula": "P·r·t ÷ 100",
      "description": "Interest.",
      "whenToUse": "Loans.",
      "simpleExample": "5,000 × 8 × 3/100"
    },
    {
      "title": "Compound amount",
      "formula": "P(1 + r/100)ⁿ",
      "description": "Growth.",
      "whenToUse": "Compound.",
      "simpleExample": "10,000, 10%, 2 y"
    },
    {
      "title": "Average speed (equal distances)",
      "formula": "2ab/(a + b)",
      "description": "Two speeds.",
      "whenToUse": "Round trips.",
      "simpleExample": "60, 40 → 48"
    },
    {
      "title": "Work together",
      "formula": "1/T = 1/a + 1/b",
      "description": "Two workers.",
      "whenToUse": "Work.",
      "simpleExample": "12, 24 → 8"
    },
    {
      "title": "Nᴾᵣ and Nᶜᵣ",
      "formula": "n!/(n − r)!, n!/(r!(n − r)!)",
      "description": "Counting.",
      "whenToUse": "Arrangements.",
      "simpleExample": "5P3 = 60"
    },
    {
      "title": "Circle",
      "formula": "Area πr², circumference 2πr",
      "description": "Circles.",
      "whenToUse": "Mensuration.",
      "simpleExample": "r = 7"
    }
  ],
  "detailedExplanation": {
    "mainNarrative": [
      "Percent change: from 80 to 100 the change is 20; 20 ÷ 80 = 25%.",
      "Compound amount: ₹10,000 at 10% for 2 years is 10,000 × 1.21 = ₹12,100.",
      "Average speed over equal distances at 60 and 40 km/h is 2 × 60 × 40 ÷ 100 = 48 km/h.",
      "Two workers taking 12 and 24 days finish together in 8 days.",
      "Arrangements of 3 from 5: 5P3 = 5 × 4 × 3 = 60; selections 5C3 = 10."
    ],
