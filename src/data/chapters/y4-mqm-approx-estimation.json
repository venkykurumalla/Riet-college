  "title": "Approximation and Estimation",
  "tagline": "Year 4 — Rounding sensibly, bounding answers and estimating roots, percentages and products when options are far apart",
  "estimatedMinutes": 55,
  "difficulty": "Advanced",
  "introduction": {
    "overview": "When the options of a question are far apart you do not need an exact answer; you need a close one, quickly. Approximation replaces numbers by nearby round ones, uses benchmark percentages, and bounds an answer between two easy values. The skill lies in choosing the precision: round more when options are spread, less when they are close.",
    "placementRelevance": "Timed tests reward approximation on arithmetic-heavy items, especially in data interpretation and simplification.",
    "realWorldContext": "Estimating costs, distances and quantities quickly is a daily workplace skill."
  },
  "learningObjectives": [
    "Round to two significant figures safely",
    "Use benchmark percentages and fractions",
    "Estimate square roots and products",
    "Bound an answer between two known values",
    "Judge the precision needed from the options"
  ],
  "prerequisiteKnowledge": {
    "requiredTopics": [
      "Advanced Calculation Techniques",
      "Simplification"
    ],
    "quickRefresher": "Relative error ≈ (rounded − exact) ÷ exact. Rounding both numbers of a product in opposite directions partly cancels the error."
  },
  "conceptExplanation": {
    "coreDefinitions": [
      "Approximation: replacing a number by a nearby simpler one.",
      "Significant figures: digits that carry the value (4,180 has 3 or 2).",
      "Bounding: placing an answer between a lower and upper estimate.",
      "Benchmark: an easy percentage or fraction to compare against.",
      "Option spacing: the gap between answer choices."
    ],
    "theoreticalIntuition": "If the options are 10% apart, an error of 2% is harmless; if they are 1% apart, estimate more carefully or compute exactly.",
    "visualOrMentalModel": "Round to two figures, compute, compare with options. If two are close, tighten the rounding or calculate exactly."
  },
  "importantRulesAndFormulas": [
    {
      "title": "Round both",
      "formula": "4,180 × 52 ≈ 4,200 × 50",
      "description": "Products.",
      "whenToUse": "Quick.",
      "simpleExample": "≈ 210,000"
    },
    {
      "title": "Benchmark %",
      "formula": "10% = ÷10; 5% = half; 1% = ÷100",
      "description": "Percentages.",
      "whenToUse": "Quick.",
      "simpleExample": "15% of 840"
    },
    {
      "title": "Root bound",
      "formula": "√n between consecutive squares",
      "description": "Roots.",
      "whenToUse": "Estimate.",
      "simpleExample": "√150 between 12 and 13"
    },
    {
      "title": "Error direction",
      "formula": "Round one up, one down",
      "description": "Products.",
      "whenToUse": "Cancels.",
      "simpleExample": "48 × 52"
    },
    {
      "title": "Tighten",
      "formula": "Add one significant figure",
      "description": "Close options.",
      "whenToUse": "Precision.",
      "simpleExample": "4,180 → 4,200 → 4,180"
    }
  ],
  "detailedExplanation": {
    "mainNarrative": [
      "4,180 × 52 ≈ 4,200 × 50 = 210,000; the exact value is 217,360. The difference is about 3%, safe if options are more than 5% apart.",
      "15% of 840: 10% is 84 and 5% is 42, so 126.",
      "√150: 12² = 144 and 13² = 169, so √150 is a little above 12; since 150 is 6 above 144, √150 ≈ 12 + 6/24 = 12.25.",
      "A growth from 4,180 to 4,970 is about 800 ÷ 4,200 ≈ 19%.",
      "If options are 24%, 25% and 26%, rough rounding is not enough; calculate exactly."
    ],
    "deepDiveAspects": [
      {
        "title": "Linear approximation for roots",
        "content": "√(a² + d) ≈ a + d/(2a) for small d."
      },
      {
        "title": "Cancelling rounding errors",
        "content": "Round numerator down and denominator down by the same percentage to keep a ratio the same."
      }
    ]
  },
