        {
          "stepNumber": 2,
          "title": "Sum",
          "explanation": "18/(1 − 1/3) = 18 × 3/2 = 27."
        }
      ],
      "finalAnswer": "27",
      "whyItWorks": "Since |r| < 1 the sum exists.",
      "commonTrap": "Taking r = 3.",
      "difficulty": "Intermediate"
