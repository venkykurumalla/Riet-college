  "difficulty": "Advanced",
  "introduction": {
    "overview": "A shortcut is a way to replace a long calculation by two short ones. The most useful speed shortcuts rest on four facts: 5 = 10 ÷ 2, 25 = 100 ÷ 4, 125 = 1000 ÷ 8, and 9 or 99 = 10 or 100 minus 1. Together with squares of numbers ending in 5 and percentage–fraction equivalents, they cover most multiplication and division in aptitude tests. A shortcut is only worth using if it is faster than direct calculation for you, so each one here is shown with its reason and a quick check.",
    "placementRelevance": "Saving 15–20 seconds on arithmetic-heavy questions adds several questions to your attempt count in a timed section.",
    "realWorldContext": "Quick mental arithmetic helps with bills, discounts and estimates."
  },
  "learningObjectives": [
    "Multiply and divide by 5, 25 and 125 using halving and quartering",
    "Multiply by 9, 99 and 11 quickly",
    "Square numbers ending in 5",
    "Convert percentages to fractions for quick calculation",
    "Check results with the last digit"
  ],
  "prerequisiteKnowledge": {
    "requiredTopics": [
      "Advanced Calculation Techniques",
      "Percentages"
    ],
    "quickRefresher": "5 = 10 ÷ 2; 25 = 100 ÷ 4; 125 = 1000 ÷ 8; 99 = 100 − 1; (10a + 5)² = a(a + 1) hundred + 25."
  },
  "conceptExplanation": {
    "coreDefinitions": [
      "Shortcut: a faster equivalent calculation.",
      "Complement: the amount needed to reach a base such as 100.",
      "Percentage–fraction equivalent: 12.5% = 1/8 and so on.",
      "Last-digit check: the final digit of a product follows from the final digits.",
      "Break-even speed: the point where a shortcut beats direct calculation."
    ],
    "theoreticalIntuition": "Multiplying by 5 is multiplying by 10 and halving; the same logic covers 25 and 125.",
    "visualOrMentalModel": "Look at the multiplier: if it is near a power of ten, or divides one, use that."
  },
  "importantRulesAndFormulas": [
    {
      "title": "× 5",
      "formula": "n × 10 ÷ 2",
      "description": "Any n.",
      "whenToUse": "Quick.",
      "simpleExample": "48 × 5 = 480 ÷ 2 = 240"
    },
    {
      "title": "× 25",
      "formula": "n × 100 ÷ 4",
      "description": "Any n.",
      "whenToUse": "Quick.",
      "simpleExample": "36 × 25 = 3,600 ÷ 4 = 900"
    },
    {
      "title": "× 125",
      "formula": "n × 1000 ÷ 8",
      "description": "Any n.",
      "whenToUse": "Quick.",
      "simpleExample": "24 × 125 = 3,000"
    },
    {
      "title": "× 99",
      "formula": "n × 100 − n",
      "description": "Any n.",
      "whenToUse": "Quick.",
      "simpleExample": "47 × 99 = 4,653"
    },
    {
      "title": "Square ending 5",
      "formula": "a(a + 1) then 25",
      "description": "15², 25², 35²…",
      "whenToUse": "Quick.",
      "simpleExample": "35² = 12|25 = 1,225"
    }
  ],
  "detailedExplanation": {
    "mainNarrative": [
      "48 × 5: multiply by 10 to get 480, then halve to 240.",
      "36 × 25: 3,600 ÷ 4 = 900. 24 × 125: 24,000 ÷ 8 = 3,000.",
      "47 × 99: 4,700 − 47 = 4,653.",
      "35²: 3 × 4 = 12, then 25: 1,225.",
      "Percentages as fractions: 12.5% of 480 is 480 ÷ 8 = 60; 37.5% = 3/8 so 3 × 60 = 180."
    ],
    "deepDiveAspects": [
